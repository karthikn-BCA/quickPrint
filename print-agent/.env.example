# Backend API connection
BACKEND_URL=http://localhost:5000

# Print Agent authentication key (must match backend PRINT_AGENT_API_KEY)
PRINT_AGENT_API_KEY=cp_agent_key_campusprint_secure_2026

# Local Agent Identifier
AGENT_ID=windows-sac-agent-01

# Connected Windows printer name (Exact name in Windows Printers & Scanners)
PRINTER_NAME=Campus Xerox High-Speed Printer

# Polling and Heartbeat intervals (in milliseconds)
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=15000

# Simulation Mode: set to true to test full spooling workflow without wasting paper
SIMULATION_MODE=true
